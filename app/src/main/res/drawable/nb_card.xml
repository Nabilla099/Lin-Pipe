<?xml version="1.0" encoding="utf-8"?>
<!-- Card with thick border and a hard offset shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/lp_shadow" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/lp_surface" />
            <stroke
                android:width="2.5dp"
                android:color="?attr/lp_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
