<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/lp_shadow" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/lp_accent" />
            <stroke
                android:width="2.5dp"
                android:color="?attr/lp_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
